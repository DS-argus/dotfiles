#!/usr/bin/env bash
# Set the desktop and lock screen to a single image.
#
#   wallpaper-set <path | URL> [--scale auto|fit|fill|stretch|center]
#   wallpaper-set --show
#
# A URL, or a path outside the library directory, is copied into
# ~/Pictures/Wallpapers/ first and the copy is used. A path already inside the
# library directory is used as is.
#
# Since macOS 14 the lock screen mirrors the desktop and cannot be set
# separately, so this also updates the login window background
# (com.apple.wallpaper SystemWallpaperURL).
set -euo pipefail

DEST="$HOME/Pictures/Wallpapers"
SCALE="auto"

die() { printf 'wallpaper-set: %s\n' "$1" >&2; exit 1; }

show_current() {
  echo "Desktop:"
  wallpaper get | sed 's/^/  /'
  echo "Login window:"
  defaults read com.apple.wallpaper SystemWallpaperURL 2>/dev/null | sed 's/^/  /' \
    || echo "  (not set)"
  echo "Screens:"
  wallpaper screens | sed 's/^/  /'
}

# --- arguments --------------------------------------------------------------
SRC=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --show) command -v wallpaper >/dev/null 2>&1 || die "wallpaper CLI not found"; show_current; exit 0 ;;
    --scale) [[ $# -ge 2 ]] || die "--scale needs a value"; SCALE=$2; shift 2 ;;
    -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *)  [[ -z $SRC ]] || die "expected a single argument"; SRC=$1; shift ;;
  esac
done
[[ -n $SRC ]] || die "an image path or URL is required (see --help)"

case $SCALE in auto|fit|fill|stretch|center) ;; *) die "invalid --scale: $SCALE" ;; esac

# --- dependencies -----------------------------------------------------------
command -v wallpaper >/dev/null 2>&1 || die "wallpaper CLI not found. 'brew install wallpaper'"
command -v magick    >/dev/null 2>&1 || die "imagemagick not found. 'brew install imagemagick'"

mkdir -p "$DEST"

# --- source resolution ------------------------------------------------------
verify_image() { magick identify "$1" >/dev/null 2>&1; }

resolve_source() {
  local src=$1 name tmp

  if [[ $src == http://* || $src == https://* ]]; then
    # Strip the query string and fragment to derive a filename.
    name=${src%%\?*}; name=${name%%#*}; name=${name##*/}
    [[ -n $name ]] || name="wallpaper-$(date +%Y%m%d%H%M%S)"
    tmp=$(mktemp "${TMPDIR:-/tmp}/wallpaper-set.XXXXXX")
    curl -fsSL --max-time 120 -o "$tmp" "$src" \
      || { rm -f "$tmp"; die "download failed: $src"; }
    verify_image "$tmp" || { rm -f "$tmp"; die "not an image: $src"; }
    mv "$tmp" "$DEST/$name"
    printf '  downloaded: %s\n' "$DEST/$name" >&2
    printf '%s' "$DEST/$name"
    return
  fi

  [[ -f $src ]] || die "no such file: $src"
  src=$(cd "$(dirname "$src")" && printf '%s/%s' "$PWD" "$(basename "$src")")
  verify_image "$src" || die "not an image: $src"

  if [[ $src == "$DEST"/* ]]; then
    printf '  already in library: %s\n' "$src" >&2
  else
    cp "$src" "$DEST/$(basename "$src")"
    src="$DEST/$(basename "$src")"
    printf '  copied: %s\n' "$src" >&2
  fi
  printf '%s' "$src"
}

IMG=$(resolve_source "$SRC")

# --- background color and scale ---------------------------------------------
# If all four corners share one color the image has a flat background, so fit it
# and pad with that color. For a photo the corners differ, so fill the screen.
# identify prints no trailing newline; without \n, read hits EOF, returns 1 and
# set -e aborts the script.
read -r W H < <(magick identify -format '%w %h\n' "$IMG")
corner() { magick "$IMG" -format "%[hex:p{$1,$2}]" info: | cut -c1-6; }
C1=$(corner 0 0); C2=$(corner $((W-1)) 0); C3=$(corner 0 $((H-1))); C4=$(corner $((W-1)) $((H-1)))

if [[ $C1 == "$C2" && $C2 == "$C3" && $C3 == "$C4" ]]; then
  FLAT=1; FILL=$C1
else
  FLAT=0; FILL=$C1
fi

if [[ $SCALE == auto ]]; then
  # fit never crops. On a screen whose aspect matches the image it is identical
  # to fill; on a mismatched one (a portrait monitor) the padding is filled with
  # the background color, so one rule covers every screen.
  if (( FLAT )); then SCALE=fit; else SCALE=fill; fi
fi

# --- apply ------------------------------------------------------------------
printf 'image : %s (%sx%s)\n' "$IMG" "$W" "$H"
printf 'color : #%s%s\n' "$FILL" "$( ((FLAT)) && echo ' (flat background)' || echo ' (corners differ; padding color is a guess)')"
printf 'scale : %s\n' "$SCALE"

# Update the lock screen (login window) first. Running killall right after
# `wallpaper set` kills WallpaperAgent while it is still applying the change and
# leaves the desktop stuck on $HOME. Restart the agent first, then set last.
defaults write com.apple.wallpaper SystemWallpaperURL -string "file://$IMG"
killall WallpaperAgent 2>/dev/null || true
sleep 3

wallpaper set "$IMG" --screen all --scale "$SCALE" --fill-color "$FILL"
sleep 1

printf '\nDone.\n'
show_current
