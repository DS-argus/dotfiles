#!/bin/bash
# SketchyBar — Nord 투명 플로팅 바 (AeroSpace 연동)
CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

FONT="JetBrainsMono Nerd Font"

# ---------------------------------------------------------------- bar
sketchybar --bar \
  height=28 \
  position=top \
  sticky=on \
  margin=8 \
  y_offset=6 \
  corner_radius=9 \
  color=$BAR_COLOR \
  shadow=off \
  padding_left=5 \
  padding_right=5

# ---------------------------------------------------------------- defaults
sketchybar --default \
  icon.font="$FONT:Bold:12.0" \
  icon.color=$TEXT \
  label.font="$FONT:SemiBold:11.0" \
  label.color=$TEXT \
  icon.padding_left=3 \
  icon.padding_right=2 \
  label.padding_left=2 \
  label.padding_right=3 \
  background.corner_radius=5 \
  background.height=20

# ---------------------------------------------------------------- events
sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_mode_change

# ---------------------------------------------------------------- aerospace mode badge (leftmost)
sketchybar --add item mode left \
  --subscribe mode aerospace_mode_change \
  --set mode \
    icon="󰒓" \
    icon.color=$BG_DARK \
    icon.padding_left=6 \
    icon.padding_right=6 \
    background.color=$YELLOW \
    background.drawing=on \
    drawing=off \
    click_script="aerospace mode main && sketchybar --trigger aerospace_mode_change MODE=main" \
    script="$PLUGIN_DIR/mode.sh"

# ---------------------------------------------------------------- workspaces (left)
# 워크스페이스 목록은 aerospace.toml 바인딩에서 파싱 (빈 워크스페이스는 런타임 목록에서 빠질 수 있음)
WORKSPACES=$(grep -oE "'workspace [0-9A-Za-z]+'" "$HOME/.config/aerospace/aerospace.toml" | tr -d "'" | awk '{print $2}' | sort -u)
[ -z "$WORKSPACES" ] && WORKSPACES=$(aerospace list-workspaces --all)

for sid in $WORKSPACES; do
  sketchybar --add item "space.$sid" left \
    --subscribe "space.$sid" aerospace_workspace_change front_app_switched \
    --set "space.$sid" \
      icon="$sid" \
      icon.padding_left=5 \
      icon.padding_right=2 \
      icon.highlight_color=$BG_DARK \
      label.font="sketchybar-app-font:Regular:13.0" \
      label.padding_left=0 \
      label.padding_right=5 \
      label.y_offset=-1 \
      label.drawing=off \
      background.color=$FROST1 \
      background.drawing=off \
      click_script="aerospace workspace $sid" \
      script="$PLUGIN_DIR/aerospace.sh $sid"
done

# ---------------------------------------------------------------- front app (left)
sketchybar --add item front_app left \
  --subscribe front_app front_app_switched \
  --set front_app \
    icon="󰣆" \
    icon.color=$FROST2 \
    icon.padding_left=7 \
    label.font="$FONT:Bold:11.0" \
    script="$PLUGIN_DIR/front_app.sh"

# ---------------------------------------------------------------- status (right, 추가 순 = 오른쪽부터)
sketchybar --add item clock right \
  --set clock \
    icon="󰥔" \
    icon.font="$FONT:Bold:14.0" \
    icon.color=$FROST1 \
    update_freq=10 \
    click_script="open -a Calendar" \
    script="$PLUGIN_DIR/clock.sh"

sketchybar --add item calendar right \
  --set calendar \
    icon="󰃭" \
    icon.font="$FONT:Bold:14.0" \
    icon.color=$YELLOW \
    label.max_chars=12 \
    drawing=off \
    update_freq=300 \
    click_script="open -a Calendar" \
    script="$PLUGIN_DIR/calendar.sh"

sketchybar --add item battery right \
  --subscribe battery system_woke power_source_change mouse.clicked \
  --set battery \
    icon.font="$FONT:Bold:14.0" \
    update_freq=120 \
    popup.align=center \
    popup.y_offset=6 \
    popup.height=26 \
    popup.background.color=$GROUP_COLOR \
    popup.background.corner_radius=3 \
    popup.background.border_color=$BORDER \
    popup.background.border_width=2 \
    script="$PLUGIN_DIR/battery.sh"

sketchybar --add item volume right \
  --subscribe volume volume_change mouse.clicked mouse.scrolled \
  --set volume \
    icon.font="$FONT:Bold:14.0" \
    icon.color=$FROST2 \
    popup.align=center \
    popup.y_offset=6 \
    popup.height=28 \
    popup.background.color=$GROUP_COLOR \
    popup.background.corner_radius=3 \
    popup.background.border_color=$BORDER \
    popup.background.border_width=2 \
    script="$PLUGIN_DIR/volume.sh"

sketchybar --add item wifi right \
  --subscribe wifi wifi_change system_woke mouse.entered mouse.exited mouse.exited.global \
  --set wifi \
    icon.font="$FONT:Bold:14.0" \
    label.drawing=off \
    update_freq=30 \
    click_script="open 'x-apple.systempreferences:com.apple.wifi-settings-extension'" \
    popup.align=center \
    popup.y_offset=6 \
    popup.height=26 \
    popup.background.color=$GROUP_COLOR \
    popup.background.corner_radius=3 \
    popup.background.border_color=$BORDER \
    popup.background.border_width=2 \
    script="$PLUGIN_DIR/wifi.sh"

sketchybar --add item bluetooth right \
  --subscribe bluetooth system_woke mouse.entered mouse.exited mouse.exited.global \
  --set bluetooth \
    icon.font="$FONT:Bold:14.0" \
    label.drawing=off \
    update_freq=30 \
    click_script="open 'x-apple.systempreferences:com.apple.BluetoothSettings'" \
    popup.align=center \
    popup.y_offset=6 \
    popup.height=26 \
    popup.background.color=$GROUP_COLOR \
    popup.background.corner_radius=3 \
    popup.background.border_color=$BORDER \
    popup.background.border_width=2 \
    script="$PLUGIN_DIR/bluetooth.sh"

sketchybar --add item dev_network right \
  --subscribe dev_network mouse.clicked \
  --set dev_network \
    icon="󰦝" \
    icon.font="$FONT:Bold:14.0" \
    label.drawing=off \
    drawing=off \
    update_freq=15 \
    popup.align=center \
    popup.y_offset=6 \
    popup.height=26 \
    popup.background.color=$GROUP_COLOR \
    popup.background.corner_radius=3 \
    popup.background.border_color=$BORDER \
    popup.background.border_width=2 \
    script="$PLUGIN_DIR/dev_network.sh"

sketchybar --add item focus right \
  --set focus \
    icon="󰤄" \
    icon.font="$FONT:Bold:14.0" \
    icon.color=$FROST3 \
    drawing=off \
    update_freq=5 \
    click_script="open 'x-apple.systempreferences:com.apple.Focus-Settings.extension'" \
    script="$PLUGIN_DIR/focus.sh"

# ---------------------------------------------------------------- GitHub notifications island (right)
sketchybar --add item dev_separator right \
  --set dev_separator \
    width=6 \
    icon.drawing=off \
    label.drawing=off

sketchybar --add item github right \
  --set github \
    icon="󰊤" \
    icon.font="$FONT:Bold:14.0" \
    drawing=off \
    update_freq=300 \
    click_script="open 'https://github.com/notifications'" \
    script="$PLUGIN_DIR/github.sh"

# ---------------------------------------------------------------- compact popups
# Volume: draggable slider + mute toggle
sketchybar --add slider volume.slider popup.volume 140 \
  --subscribe volume.slider mouse.clicked \
  --set volume.slider \
    slider.highlight_color=$FROST1 \
    slider.background.color=$MUTED \
    slider.background.height=6 \
    slider.background.corner_radius=3 \
    slider.knob="●" \
    slider.knob.color=$TEXT \
    padding_left=10 \
    padding_right=10 \
    script="$PLUGIN_DIR/volume_control.sh"

sketchybar --add item volume.mute popup.volume \
  --subscribe volume.mute mouse.clicked \
  --set volume.mute \
    icon="󰝟" \
    icon.color=$FROST2 \
    label="Mute" \
    script="$PLUGIN_DIR/volume_control.sh"

# Battery: source and remaining-time/status details
sketchybar --add item battery.source popup.battery \
  --set battery.source icon="󰂄" icon.color=$GREEN label="Power Source"
sketchybar --add item battery.detail popup.battery \
  --set battery.detail icon="󰔟" icon.color=$FROST1 label="Time Remaining"

# Wi-Fi: 연결 상태와 현재 IP
sketchybar --add item wifi.status popup.wifi \
  --set wifi.status icon="󰖩" icon.color=$FROST2 label="Wi-Fi · Checking"
sketchybar --add item wifi.ip popup.wifi \
  --set wifi.ip icon="󰩠" icon.color=$FROST1 label="IP · Checking"

# Bluetooth: 전원 상태와 연결 기기
sketchybar --add item bluetooth.status popup.bluetooth \
  --set bluetooth.status icon="󰂯" icon.color=$FROST3 label="Bluetooth · Checking"
sketchybar --add item bluetooth.devices popup.bluetooth \
  --set bluetooth.devices icon="󰂱" icon.color=$FROST1 label="Devices · Checking" label.max_chars=32

# Tailscale: address, MagicDNS hostname and online peer count
sketchybar --add item dev_network.ip popup.dev_network \
  --set dev_network.ip icon="󰩠" icon.color=$GREEN label="IP"
sketchybar --add item dev_network.host popup.dev_network \
  --set dev_network.host icon="󰒋" icon.color=$FROST2 label="Host"
sketchybar --add item dev_network.peers popup.dev_network \
  --set dev_network.peers icon="󰓾" icon.color=$FROST1 label="Online peers"
# ---------------------------------------------------------------- island groups
# 바는 투명, 아이템 묶음에만 배경 → 빈 영역은 배경화면 그대로
sketchybar --add bracket left_group mode '/space\..*/' front_app \
  --set left_group \
    background.color=$GROUP_COLOR \
    background.corner_radius=3 \
    background.height=28 \
    background.border_color=$BORDER \
    background.border_width=2

sketchybar --add item system_separator right \
  --set system_separator \
    width=6 \
    icon.drawing=off \
    label.drawing=off
# ---------------------------------------------------------------- system monitor island (right)
# 오른쪽 상태 아일랜드 왼쪽에 CPU 숫자+그래프와 memory pressure를 별도 표시
sketchybar --add item memory right \
  --set memory \
    icon="󰍛" \
    icon.font="$FONT:Bold:14.0" \
    label.width=30 \
    label.align=right \
    update_freq=5 \
    click_script="open -a 'Activity Monitor'" \
    script="$PLUGIN_DIR/memory.sh"

sketchybar --add graph cpu_graph right 38 \
  --set cpu_graph \
    graph.line_width=1.5 \
    background.drawing=on \
    background.color=0x00000000 \
    background.height=18 \
    y_offset=0 \
    update_freq=3 \
    click_script="open -a 'Activity Monitor'" \
    script="$PLUGIN_DIR/cpu.sh"

sketchybar --add item cpu right \
  --set cpu \
    icon="󰻠" \
    icon.font="$FONT:Bold:14.0" \
    label.width=30 \
    label.align=right \
    click_script="open -a 'Activity Monitor'"

# CPU/RAM과 분리된 Codex 계정 사용량 아일랜드
sketchybar --add item codex_separator right \
  --set codex_separator width=6 icon.drawing=off label.drawing=off

# right 항목은 추가할수록 왼쪽에 배치되므로 화면의 역순으로 등록
sketchybar --add item codex.x5.secondary right \
  --set codex.x5.secondary icon="×5" icon.font="$FONT:Bold:10.0" icon.color=$FROST2 label.font="$FONT:SemiBold:10.0"
sketchybar --add item codex.divider.2 right \
  --set codex.divider.2 icon.drawing=off label="│" label.font="$FONT:Bold:12.0" label.color=$FROST3 label.padding_left=2 label.padding_right=2
sketchybar --add item codex.x5.primary right \
  --set codex.x5.primary icon="×5" icon.font="$FONT:Bold:10.0" icon.color=$FROST1 label.font="$FONT:SemiBold:10.0"
sketchybar --add item codex.divider.1 right \
  --set codex.divider.1 icon.drawing=off label="│" label.font="$FONT:Bold:12.0" label.color=$FROST3 label.padding_left=2 label.padding_right=2
sketchybar --add item codex.x20 right \
  --set codex.x20 icon="×20" icon.font="$FONT:Bold:10.0" icon.color=$FROST0 label.font="$FONT:SemiBold:10.0"
sketchybar --add item codex_usage right \
  --set codex_usage \
    icon=":codex:" \
    icon.font="sketchybar-app-font:Regular:14.0" \
    icon.color=$FROST2 \
    icon.padding_left=5 \
    icon.padding_right=4 \
    label.drawing=off \
    update_freq=60 \
    script="$PLUGIN_DIR/codex_usage.sh"
sketchybar --set codex_usage click_script="$PLUGIN_DIR/codexbar_toggle.sh" \
  --set '/codex\..*/' click_script="$PLUGIN_DIR/codexbar_toggle.sh"
sketchybar --add bracket right_group clock calendar battery volume wifi bluetooth dev_network focus \
  --set right_group \
    background.color=$GROUP_COLOR \
    background.corner_radius=3 \
    background.height=28 \
    background.border_color=$BORDER \
    background.border_width=2

sketchybar --add bracket dev_group github \
  --set dev_group \
    background.color=$GROUP_COLOR \
    background.corner_radius=3 \
    background.height=28 \
    background.border_color=$BORDER \
    background.border_width=2
sketchybar --add bracket codex_group codex_usage codex.x20 codex.divider.1 codex.x5.primary codex.divider.2 codex.x5.secondary \
  --set codex_group \
    background.color=$GROUP_COLOR \
    background.corner_radius=3 \
    background.height=28 \
    background.border_color=$BORDER \
    background.border_width=2
sketchybar --add bracket system_group cpu cpu_graph memory \
  --set system_group \
    background.color=$GROUP_COLOR \
    background.corner_radius=3 \
    background.height=28 \
    background.border_color=$BORDER \
    background.border_width=2
# ---------------------------------------------------------------- init
sketchybar --update
sketchybar --trigger aerospace_workspace_change \
  FOCUSED_WORKSPACE="$(aerospace list-workspaces --focused)"
